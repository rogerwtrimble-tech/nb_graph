# =====================================================================================
# nb_graph demo environment. Copy to .env (`make env` also generates random secrets).
# The defaults below work as-is for a local, single-user DEMO. Change them for anything else.
# =====================================================================================

# --- images -----------------------------------------------------------------------------
# PostgreSQL 19: switch to 19 / 19-alpine once the GA image is published (Oct 2026)
POSTGRES_IMAGE_TAG=19beta4-alpine
NETBOX_IMAGE=docker.io/netboxcommunity/netbox:v4.7-5.1.1

# --- published ports (host side) ---------------------------------------------------------
UI_PORT=8080
NETBOX_PORT=8000
GRAPH_API_PORT=8090
PG_PORT=5432

# --- database / cache --------------------------------------------------------------------
DB_PASSWORD=nbgraph-db-pass
REDIS_PASSWORD=nbgraph-redis-pass
REDIS_CACHE_PASSWORD=nbgraph-redis-cache-pass

# --- NetBox ------------------------------------------------------------------------------
SECRET_KEY=nbgraph-demo-secret-key-change-me-0123456789abcdefghijklmnopqrstuvwxyz
API_TOKEN_PEPPER_1=nbgraph-demo-pepper-change-me-0123456789abcdefghijklmnopqrstuv
SUPERUSER_NAME=admin
SUPERUSER_PASSWORD=admin
# v2 API token = nbt_<SUPERUSER_API_KEY>.<SUPERUSER_API_TOKEN>  (key: 12 alnum, token: 40 alnum)
SUPERUSER_API_KEY=nbgraphdemo1
SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567

# --- nb_graph ----------------------------------------------------------------------------
WEBHOOK_SECRET=nbgraph-demo-webhook
# set to false to skip loading the FTTH demo data
SEED_DEMO_DATA=true
